{
  "name": "gdevelop-mcp-server",
  "version": "0.1.0",
  "description": "Serveur MCP GDevelop over libGD.js — sessions projet via le vrai moteur, jamais de JSON édité à l'aveugle.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gdevelop-mcp-server": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:unit": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/index.js",
    "provision:libgd": "node scripts/provision-libgd.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.20.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  },
  "license": "MIT"
}
